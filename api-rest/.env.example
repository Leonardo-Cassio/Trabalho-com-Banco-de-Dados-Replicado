# ============================================================
# Copie este arquivo para .env e ajuste os valores
# ============================================================

# Porta da API
PORT=3000

# Banco de dados (leitura - réplicas)
# Para múltiplas réplicas, separe host:porta por vírgula
DB_READ_REPLICAS=127.0.0.1:3307
DB_DATABASE=aula-db
DB_USERNAME=root
DB_PASSWORD=root

# Limite para "baixo estoque"
LOW_STOCK_THRESHOLD=10
